# Copy to .env and fill in. NEVER commit .env.

# --- Gemini (aistudio.google.com -> Get API key). Billing must be enabled. ---
GEMINI_API_KEY=

# --- Instagram (see SETUP.md) ---
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Facebook Page cross-posting (OPTIONAL) ---
# Leave blank to post to Instagram only. Run: npm run fb-setup
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# --- Telegram (@BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Where the published image is served from ---
# In GitHub Actions these are set automatically.
GITHUB_REPOSITORY=TumurEnguun/Instagram-Hugjuulelt
GITHUB_BRANCH=main
